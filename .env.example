# Public URL of the deployed site, used for canonical links, the sitemap, robots.txt and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://tilawah.shahadot.dev

# Cloud sync (server only; leave unset to turn sync off). Real values go in .env.local and the host's environment settings.
DATABASE_URL=
CRON_SECRET=

# Embeddable widget visit counts (server only; leave unset to turn counting off). Any long random text works as the salt.
WIDGET_SALT=
